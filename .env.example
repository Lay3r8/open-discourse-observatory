POSTGRES_DB=discourse
POSTGRES_USER=discourse
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://discourse:change-me-local-only@localhost:5432/discourse
ODO_DATA_DIR=./data

# BigQuery / GDELT discovery.
# Leave GCP_PROJECT_ID blank to let Application Default Credentials infer it.
GCP_PROJECT_ID=
GCP_BIGQUERY_LOCATION=US
ODO_BIGQUERY_MAX_BYTES_GIB=2
ODO_NEGATIVE_SAMPLE_MODULUS=1000

# Local storage guardrails.
ODO_STORAGE_BUDGET_GIB=200
ODO_STORAGE_WARNING_GIB=150
ODO_STORAGE_STOP_GIB=170
ODO_HOST_DRIVE=E
ODO_HOST_FREE_WARNING_GIB=350
ODO_HOST_FREE_STOP_GIB=300
